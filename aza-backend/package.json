{
  "name": "aza-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "API REST del Sistema Web de Monitoreo y Trazabilidad del Trefilado (Aceros AZA). Backend Node.js + Express + Sequelize + PostgreSQL.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:sync": "node src/seed/sync.js",
    "db:seed": "node src/seed/seed.js",
    "test": "node --test tests/*.test.js",
    "db:migrate:images": "node src/seed/migrate-images.js",
    "db:migrate": "node src/seed/migrate-images.js && node src/seed/migrate-complete.js",
    "test:integration": "node scripts/verify-complete.cjs",
    "db:backup": "node scripts/backup.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
