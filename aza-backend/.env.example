# Copia este archivo a .env y completa los valores reales. Nunca subas .env al repositorio (RNF006).

# --- Servidor ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173

# --- Base de datos (PostgreSQL) ---
# Puedes usar DATABASE_URL o las variables sueltas de abajo.
DATABASE_URL=postgres://aza_app:CAMBIA_ESTA_PASSWORD@127.0.0.1:5432/aza
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aza
DB_USER=aza_app
DB_PASSWORD=CAMBIA_ESTA_PASSWORD
DB_SSL=false

# --- Seguridad / sesión (RNF001-RNF010) ---
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=30m
RESET_TOKEN_SECRET=CAMBIA_ESTE_OTRO_SECRETO
RESET_TOKEN_EXPIRES_IN=30m
BCRYPT_SALT_ROUNDS=12
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- Ingesta técnica del sistema de captura/simulador (RF047 / INT15) ---
# La app real (APP-AZA) u otro simulador debe enviar este valor en el header X-API-Key.
INGESTA_API_KEY=CAMBIA_ESTA_API_KEY_TECNICA

# --- Correo de recuperación de contraseña (HU03 / RF003) ---
# Si no defines SMTP_HOST, el servidor usa una cuenta de prueba Ethereal
# (correo real de demostración, no llega a bandejas reales) y expone la
# URL de vista previa en la respuesta y en el log del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AZA Monitoreo <no-responder@aza.demo>"
